# Скопируйте в .env и при желании заполните.

# Учётка Navidrome (созданная в веб-интерфейсе :4533) — тогда Hub сразу
# запускает пересканирование после скачивания. Без неё Navidrome подхватит
# новые файлы сам в течение минуты.
NAVIDROME_USER=
NAVIDROME_PASSWORD=

# m4a (без перекодирования, по умолчанию) или mp3
AUDIO_FORMAT=m4a
MAX_DOWNLOADS=2

# Пароль для входа. ОБЯЗАТЕЛЕН, если сервис открыт в интернет (Cloudflare Tunnel).
# Придумайте длинный, не короче 8 символов. Пусто — без защиты (только дом).
HUB_PASSWORD=

# Токен постоянного туннеля Cloudflare (см. README); для docker compose --profile tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# Во сколько часов утра пересобирать «Микс дня»
MIX_HOUR=6
# Модель эмбеддера (CLAP, 512 чисел на трек)
EMBED_MODEL=laion/larger_clap_music
