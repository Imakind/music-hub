# Файл .env для СЕРВЕРА (docker-compose.server.yml). Лежит рядом с compose-файлом.

# Адрес без https://. Без своего домена подойдёт IP через sslip.io:
# IP 203.0.113.7 -> 203-0-113-7.sslip.io
DOMAIN=

# Пароль для входа в плеер (не короче 8 символов)
HUB_PASSWORD=

# Общий секрет сервера и домашнего воркера: такой же WORKER_TOKEN в .env на домашнем ПК
WORKER_TOKEN=

MIX_HOUR=6
